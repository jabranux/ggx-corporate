# GGX Business+ — env vars.
# Copy to .env.local for local development.

# ─── Corporate session auth (server-only — api/auth/*.ts, api/_lib/session.ts)
# REQUIRED for /api/auth/login and /api/support/** to work at all — both fail
# closed (clear 500) if unset, rather than silently issuing/accepting
# unsigned sessions. The HMAC key that signs the httpOnly session cookie
# `/api/auth/login` issues; `/api/support/**` verifies every request's cookie
# against it before deriving Bridge identity (see api/_lib/session.ts). Set a
# long random value (e.g. `openssl rand -base64 48`), server-side only, never
# committed, never a VITE_-prefixed variable. Rotating it invalidates every
# outstanding session (forces re-login) — nothing else is affected.
SESSION_SECRET=

# ─── Corporate support proxy (server-only — api/support/**, api/_lib/bridge.ts)
# NEVER prefix these VITE_ — a VITE_-prefixed var is bundled into the browser
# build. These are read only by the serverless functions under /api, which
# Vite never bundles. See docs/migration/ggx-corporate-heyq-live-ticketing.md.
# REQUIRED for the support proxy to work at all — it fails closed (clear 500)
# with either one unset, rather than silently calling Bridge unauthenticated
# or not at all.

# The shared QuadX Bridge secret. Attached server-side as the
# `X-Corporate-Internal-Key` header on every proxied request; the browser never
# sees it. Configured on the Bridge side via
# `supabase secrets set QUADX_BRIDGE_API_KEY=... --project-ref rwzwktrepfgsooerpyjx`
# (see docs/migration/ggx-corporate-heyq-live-ticketing.md §15) — get the
# matching value from whoever holds it; it is never recorded in this repo.
QUADX_BRIDGE_API_KEY=

# The deployed QuadX Bridge origin the proxy forwards to (no trailing slash, no
# path suffix — the proxy appends /customer/tickets etc. itself).
#
# QuadX Bridge is now hosted as a Supabase Edge Function in HeyQ's own
# Supabase project (rwzwktrepfgsooerpyjx) — see
# docs/migration/ggx-corporate-heyq-live-ticketing.md §15. Production value:
# https://rwzwktrepfgsooerpyjx.supabase.co/functions/v1/quadx-bridge
# (live-validated end-to-end — see §15 for the full results). Set this in
# Vercel's Production/Preview env, never committed here.
#
# For local development against a locally-run Supabase stack in the HeyQ repo
# (`npx supabase start`, then the function is served automatically):
# http://127.0.0.1:54321/functions/v1/quadx-bridge
QUADX_BRIDGE_URL=

# ─── Commerce backend (server-only — api/commerce/**, scripts/apply-commerce-migrations.mjs)
# A dedicated GGX Corporate / Business+ Supabase project — separate from
# QuadX Bridge/HeyQ's own project. Owns Inventory/Storefront/Promotions data
# (products, variants, SKUs, storefronts, collections, banners, promotions).
# NEVER prefix these VITE_.

# Postgres connection string (Project Settings -> Database -> Connection
# string) for the dedicated Commerce Supabase project. The BFF and
# scripts/apply-commerce-migrations.mjs both fail closed (clear error) if
# unset. NOTE: currently provisioned as the DIRECT (:5432) connection, not
# the pooled Supavisor one — fine for migrations/dev, but Vercel serverless
# traffic should move to the pooled ("Transaction" mode, :6543) connection
# string before this goes live, to avoid exhausting Postgres's direct
# connection limit under concurrent invocations.
GGX_COMMERCE_DATABASE_URL=

# Supabase project URL + secret (service-role-equivalent) API key, for the
# Data API / supabase-js — currently unused by the BFF (which talks to
# Postgres directly via GGX_COMMERCE_DATABASE_URL so it can use real
# transactions/row-locking for SKU allocation and promotion redemption, which
# the Data API doesn't support), kept for any future RPC/Storage use.
GGX_COMMERCE_SUPABASE_URL=
GGX_COMMERCE_SUPABASE_SECRET_KEY=

# ─── Commerce media storage (server-only — Cloudflare R2) ───────────────────
# Object storage for product photos, storefront logos, and hero banners.
# Credentials are server-only: the BFF mints short-lived presigned upload
# URLs so image bytes go straight from the browser to R2, never through this
# server and never with the secret key reaching the browser.
GGX_COMMERCE_R2_ACCOUNT_ID=
GGX_COMMERCE_R2_ACCESS_KEY_ID=
GGX_COMMERCE_R2_SECRET_ACCESS_KEY=
# Bucket: ggx-corporate-commerce-assets
GGX_COMMERCE_R2_BUCKET=
# Public base URL for reading uploaded images back (R2 public bucket URL or a
# connected custom domain) — no trailing slash.
GGX_COMMERCE_R2_PUBLIC_URL=

# ─── HeyQ integration (DORMANT — build-time, Vite; must be prefixed VITE_) ───
# NOT used by any ticket read/write today (those go through the proxy above).
# Kept only as the base for two UNUSED capabilities left in the codebase as
# documented dormant code (realtime WebSocket token minting, attachment
# download URLs) — see heyqCustomerApi.ts's module docblock. Optional: sensible
# defaults are baked in.

# The legacy standalone HeyQ API origin. No trailing slash, no /api suffix.
# Default: https://heyq-api-production.up.railway.app
VITE_HEYQ_API_URL=

# The HeyQ FRONTEND origin — used only to OPEN HeyQ pages (the contact form,
# the requester portal). NOT the API.
# Default: https://heyq.vercel.app
# Local against a local HeyQ frontend: http://localhost:18020
VITE_HEYQ_URL=
