# GGX Business+ — env vars.
# Copy to .env.local for local development.

# ─── Corporate support proxy (server-only — api/support/**, api/_lib/bridge.ts)
# NEVER prefix these VITE_ — a VITE_-prefixed var is bundled into the browser
# build. These are read only by the serverless functions under /api, which
# Vite never bundles. See docs/migration/ggx-corporate-heyq-live-ticketing.md.
# REQUIRED for the support proxy to work at all — it fails closed (clear 500)
# with either one unset, rather than silently calling Bridge unauthenticated
# or not at all.

# The shared QuadX Bridge secret. Attached server-side as the
# `X-Corporate-Internal-Key` header on every proxied request; the browser never
# sees it. Get it from whoever operates the deployed QuadX Bridge.
QUADX_BRIDGE_API_KEY=

# The deployed QuadX Bridge origin the proxy forwards to (no trailing slash, no
# path suffix — the proxy appends /customer/tickets etc. itself). This was not
# resolvable to a single confirmed, currently-reachable URL during this task
# (see the handoff doc's "Known limitations" section) — set it to whatever the
# QuadX Bridge operator confirms. For local development against a locally-run
# HeyQ server/ (`npm run server` in the HeyQ repo, from its server/index.ts):
# http://localhost:4310
QUADX_BRIDGE_URL=

# ─── HeyQ integration (DORMANT — build-time, Vite; must be prefixed VITE_) ───
# NOT used by any ticket read/write today (those go through the proxy above).
# Kept only as the base for two UNUSED capabilities left in the codebase as
# documented dormant code (realtime WebSocket token minting, attachment
# download URLs) — see heyqCustomerApi.ts's module docblock. Optional: sensible
# defaults are baked in.

# The legacy standalone HeyQ API origin. No trailing slash, no /api suffix.
# Default: https://heyq-api-production.up.railway.app
VITE_HEYQ_API_URL=

# The HeyQ FRONTEND origin — used only to OPEN HeyQ pages (the contact form,
# the requester portal). NOT the API.
# Default: https://heyq.vercel.app
# Local against a local HeyQ frontend: http://localhost:18020
VITE_HEYQ_URL=
